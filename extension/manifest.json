{
  "manifest_version": 3,
  "name": "X 粉丝数 · X Pro 被动版",
  "version": "1.2.6",
  "description": "在 X 和 X Pro 显示页面已加载的粉丝数、关系和号龄。无额外请求、翻页或代点，趋势记录可在本机开启。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "X 粉丝数 · X Pro 被动版",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://pro.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "runtime.js",
        "history.js",
        "card.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://pro.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "data.js",
        "network.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://github.com/vikyhuhu/x-follower-count",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
